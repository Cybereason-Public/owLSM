# Copy to .env (gitignored) for local runs.
# GitHub Actions sets the same names from repository secrets.
OKE_CLUSTER_OCID=
OKE_COMPARTMENT_OCID=
OKE_NODE_SUBNET_ID=
OKE_NODE_IMAGE_ID=
OKE_AVAILABILITY_DOMAIN_1=
OKE_AVAILABILITY_DOMAIN_2=
OKE_REGION=us-ashburn-1
OKE_SSH_PUBLIC_KEY=

## How to set other keys ENV variables
# Local: OWLSM_OKE_SSH_KEY=/path/to/private-key
# CI: OKE_SSH_PRIVATE_KEY is the PEM; write_oke_ssh_key.sh writes it to a file and sets OWLSM_OKE_SSH_KEY to that path. Do not add OKE_NODE_SSH_PRIVATE_KEY.